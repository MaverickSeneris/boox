{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "readingStatus": {
      "type": "enumeration",
      "enum": [
        "planned",
        "reading",
        "finished"
      ]
    },
    "rating": {
      "type": "decimal"
    }
  }
}
